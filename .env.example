# Server
PORT=3000
# Browser origin that serves the SPA (local, or Vercel when split-deployed)
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
# Soft-fail DB ONLY when set to 1 (otherwise process exits if Postgres is down)
ALLOW_DEGRADED=0
# Set to 1 only if Postgres TLS verify fails locally (e.g. some managed certs)
DB_SSL_INSECURE=0

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Local / IPv6-capable hosts can use the direct DB URL:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# Render (and other IPv4-only hosts) MUST use the Supavisor pooler (Session mode, port 5432):
# Supabase → Connect → Connection pooling → Session
# Host cluster may be aws-0, aws-1, … - copy exact host from Supabase Connect (Pooling).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# Google / Discord OAuth: enable in Supabase Dashboard → Authentication → Providers
# (no extra .env keys). Redirect URI for both: https://YOUR_PROJECT.supabase.co/auth/v1/callback
# App callback page: FRONTEND_URL/auth.html - see docs/runbook.md

# Twitch / IGDB (Games)
IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret
# Optional: app access token (auto-refreshed when CLIENT_SECRET is set)
IGDB_ACCESS_TOKEN=

# TMDB (Movies + Series) - https://www.themoviedb.org/settings/api
# Provide EITHER a v4 Read Access Token (preferred) OR a v3 API key.
TMDB_ACCESS_TOKEN=your-tmdb-v4-read-access-token
# TMDB_API_KEY=your-tmdb-v3-api-key

# Optional: shared rate limits across instances (requires: npm i ioredis)
# REDIS_URL=redis://localhost:6379
# CATALOG_WARM_MS=1800000
