# Server
PORT=3000
# Browser origin that serves the SPA (local, or Vercel when split-deployed)
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
# Soft-fail DB ONLY when set to 1 (otherwise process exits if Postgres is down)
ALLOW_DEGRADED=0
# Set to 1 only if Postgres TLS verify fails locally (e.g. some managed certs)
DB_SSL_INSECURE=0

# Neon Postgres (pooled connection string from the Neon Console -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon Auth (Better Auth) - the identity provider (login, register, Google OAuth).
# From: neon neon-auth status --project-id <id> --branch production
NEON_PROJECT_ID=your-neon-project-id
NEON_AUTH_BASE_URL=https://<ep>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<ep>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
# OAuth providers are enabled in the Neon Console (or `neon neon-auth oauth-provider`).
# Add your app origins as Neon Auth trusted domains (`neon neon-auth domain add <url>`).

# Twitch / IGDB (Games)
IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret
# Optional: app access token (auto-refreshed when CLIENT_SECRET is set)
IGDB_ACCESS_TOKEN=

# TMDB (Movies + Series) - https://www.themoviedb.org/settings/api
# Provide EITHER a v4 Read Access Token (preferred) OR a v3 API key.
TMDB_ACCESS_TOKEN=your-tmdb-v4-read-access-token
# TMDB_API_KEY=your-tmdb-v3-api-key

# Kitsu (Anime) needs NO API key - it's a public API. Nothing to configure.

# Social OAuth (Google / GitHub) - direct, same-origin OAuth2 (server-side only).
# Add the authorized redirect URI to each provider app:
#   <FRONTEND_URL>/api/auth/oauth/google/callback
#   <FRONTEND_URL>/api/auth/oauth/github/callback
# Omit a pair to hide that button. Never expose these in the frontend.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Optional: Sentry error tracking. Leave unset to disable (both are no-ops
# without it). Backend reads SENTRY_DSN; the frontend DSN goes in
# Frontend/common.js (global.MGL_SENTRY_DSN) or a <meta name="sentry-dsn"> tag.
# SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>

# Optional: shared rate limits across instances (requires: npm i ioredis)
# REDIS_URL=redis://localhost:6379
# CATALOG_WARM_MS=1800000
